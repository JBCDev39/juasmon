rules_version = '2';
// Reglas de seguridad de JUASmon. Copiar en Firebase → Firestore → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Reportes de preguntas: cualquiera que abra el juego puede enviar, verlos y borrarlos.
    match /reportes/{id} {
      allow read, delete: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 500;
    }

    // Reto del día: un solo puntaje por dispositivo y por día, y no se puede cambiar después.
    match /retos/{fecha}/puntajes/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name', 'score', 'right', 'at', 'color', 'icon'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 10
        && request.resource.data.right is int && request.resource.data.right >= 0 && request.resource.data.right <= 10
        && (!('color' in request.resource.data) || request.resource.data.color.matches('^#[0-9a-fA-F]{6}$'))
        && (!('icon' in request.resource.data) || (request.resource.data.icon is string && request.resource.data.icon.size() <= 12));
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
